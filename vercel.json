{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix red-sea-resilience",
  "buildCommand": "npm run build --prefix red-sea-resilience",
  "outputDirectory": "red-sea-resilience/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
