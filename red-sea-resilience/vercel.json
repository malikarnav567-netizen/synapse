{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/tf/:a/:rest*", "destination": "/api/tf/nested?path=:a/:rest*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
